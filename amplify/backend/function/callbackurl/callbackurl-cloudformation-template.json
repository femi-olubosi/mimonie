              "Ref": "callbackUrl"
            },
            "API_KEY_PROD": {
              "Ref": "apiKeyProd"
            },
            "CALLBACK_URL_PROD": {
              "Ref": "callbackUrlProd"
            },
            "JOB_STATUS_API": {
              "Ref": "jobStatusApi"
            },
            "BASIC_VERIFY_ASYNC_LIVE": {
              "Ref": "basicVerifyAsyncLive"
            },
            "BASIC_VERIFY_ASYNC": {
              "Ref": "basicVerifyAsync"
            },
            "BASIC_VERIFY": {
              "Ref": "basicVerify"
            },
            "BASIC_VERIFY_LIVE": {
              "Ref": "basicVerifyLive"
            }
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecutionRole",
            "Arn"
          ]
        },
        "Runtime": "nodejs22.x",
        "Layers": [],
        "Timeout": 25
      }
    },
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::If": [
            "ShouldNotCreateEnvResources",
            "mimonieLambdaRole39f72c50",
            {
              "Fn::Join": [
                "",
                [
                  "mimonieLambdaRole39f72c50",
                  "-",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        }
      }
    },
    "lambdaexecutionpolicy": {
      "DependsOn": [
        "LambdaExecutionRole"
      ],
      "Type": "AWS::IAM::Policy",
