{
  "expo": {
    "name": "Mimonie",
    "slug": "mimonie",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mimonie",
    "userInterfaceStyle": "automatic",
    "developmentClient": {
      "silentLaunch": true
    },
    "ios": {
      "buildNumber": "4",
      "supportsTablet": true,
      "bundleIdentifier": "com.femiolubosi.mimonie",
      "associatedDomains": ["applinks:mimonie.net"]
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#006EBD"
      },
      "package": "com.femiolubosi.mimonie",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "mimonie.net",
              "pathPrefix": "/"
            }
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-updates",
        {
          "username": "femi-olubosi"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-notifications",
      {
        "icon": "./assets/logo/mimonie-notification.png",
        "color": "#006EBD",
        "defaultChannel": "default",
        "sounds": [
          "./assets/sound/notification-sound1.wav",
          "./assets/sound/notification-sound2.wav"
        ]
      }
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "39c78bcd-192c-4415-93f2-7f24376ad86d"
      }
    },
    "owner": "femi-olubosi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/39c78bcd-192c-4415-93f2-7f24376ad86d"
    }
  }
}
