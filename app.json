{
  "expo": {
    "name": "Mimonie",
    "slug": "mimonie",
    "version": "1.1.09",
    "orientation": "default",
    "icon": "./assets/logo/mimonie.png",
    "scheme": "mimonie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "37",
      "supportsTablet": true,
      "bundleIdentifier": "com.femiolubosi.mimonie",
      "associatedDomains": ["applinks:mimonie.net"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSMinimumSystemVersion": "12.0",
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.${ios.bundleIdentifier}.onesignal"
        ]
      }
    },
    "android": {
      "versionCode": 37,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#006EBD"
      },
      "package": "com.femiolubosi.mimonie",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "mimonie.net",
              "pathPrefix": "/"
            }
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "targetSdkVersion": 35,
      "permissions": ["com.google.android.gms.permission.AD_ID"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "smallIcons": ["./assets/logo/mimonie_notification.png"],
          "largeIcons": ["./assets/logo/mimonie_notification.png"],
          "smallIconAccentColor": "#006EBD"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#006EBD"
        }
      ],
      [
        "expo-updates",
        {
          "username": "femi-olubosi"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/mimonie_notification.png",
          "color": "#006EBD",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sound/notification_sound1.wav",
            "./assets/sound/notification_sound2.wav"
          ]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Mimonie needs access to your contacts to allow you to connect with your contacts within the app. This information will only be used to identify users you may know and invite them to join your network. and will not be stored anywhere for external use"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "39c78bcd-192c-4415-93f2-7f24376ad86d"
      }
    },
    "owner": "femi-olubosi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/39c78bcd-192c-4415-93f2-7f24376ad86d"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-1971737358661516~4270723049",
    "ios_app_id": "ca-app-pub-1971737358661516~3703757547"
  }
}
